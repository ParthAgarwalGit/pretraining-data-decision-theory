# Data and large artifacts — never committed, always fetched via src/pdt/data
# Leading slash matters: unanchored "data/" matches ANY directory named
# "data" anywhere in the tree, including src/pdt/data/ (the module that
# does the fetching) -- found the hard way when that whole package silently
# didn't show up as untracked in `git status` during task P0-06.
/data/
*.parquet
*.safetensors
*.bin
*.pt
*.ckpt
wandb/

# Secrets
.env
*.token

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Environments
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# LaTeX build artifacts
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.synctex.gz
